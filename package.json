{
  "name": "codex-history-lens-hkle",
  "displayName": "Codex History Lens",
  "description": "在 VS Code 中浏览本机 Codex 会话的完整聊天记录：消息、工具调用、思考过程与截图。",
  "version": "1.2.0",
  "publisher": "hkle",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/suboy1219/codex-chat-history.git"
  },
  "bugs": {
    "url": "https://github.com/suboy1219/codex-chat-history/issues"
  },
  "homepage": "https://github.com/suboy1219/codex-chat-history#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "codex",
    "chat",
    "history",
    "session",
    "openai"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onView:codexHistory.sessions",
    "onCommand:codexHistory.open",
    "onCommand:codexHistory.openInCodex",
    "onCommand:codexHistory.restoreSession"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codexHistoryContainer",
          "title": "Codex 聊天",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "codexHistoryContainer": [
        {
          "id": "codexHistory.sessions",
          "name": "历史会话",
          "contextualTitle": "Codex History Lens"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "codexHistory.sessions",
        "contents": "还没有找到 Codex 会话记录。\n[刷新](command:codexHistory.refresh)\n如果 Codex 数据不在默认位置，请在设置中修改 `codexHistory.codexHome`。"
      }
    ],
    "commands": [
      {
        "command": "codexHistory.open",
        "title": "打开聊天记录",
        "category": "Codex",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "codexHistory.openSession",
        "title": "打开选中的聊天记录",
        "category": "Codex"
      },
      {
        "command": "codexHistory.openInCodex",
        "title": "在 Codex 中继续对话",
        "category": "Codex",
        "icon": "$(link-external)"
      },
      {
        "command": "codexHistory.restoreSession",
        "title": "还原到 Codex 对话",
        "category": "Codex",
        "icon": "$(history)"
      },
      {
        "command": "codexHistory.refresh",
        "title": "刷新会话列表",
        "category": "Codex",
        "icon": "$(refresh)"
      },
      {
        "command": "codexHistory.filter",
        "title": "筛选会话列表",
        "category": "Codex",
        "icon": "$(filter)"
      },
      {
        "command": "codexHistory.clearFilter",
        "title": "清除会话筛选",
        "category": "Codex",
        "icon": "$(clear-all)"
      },
      {
        "command": "codexHistory.toggleWorkspaceScope",
        "title": "只看当前工作区的会话",
        "category": "Codex",
        "icon": "$(root-folder)"
      },
      {
        "command": "codexHistory.searchContent",
        "title": "在全部会话内容中搜索",
        "category": "Codex",
        "icon": "$(search)"
      },
      {
        "command": "codexHistory.export",
        "title": "导出会话为 Markdown",
        "category": "Codex",
        "icon": "$(export)"
      },
      {
        "command": "codexHistory.openRaw",
        "title": "打开原始 .jsonl 记录",
        "category": "Codex",
        "icon": "$(json)"
      },
      {
        "command": "codexHistory.revealSession",
        "title": "在文件资源管理器中显示",
        "category": "Codex",
        "icon": "$(reveal)"
      },
      {
        "command": "codexHistory.revealCodexHome",
        "title": "打开 Codex 数据目录",
        "category": "Codex",
        "icon": "$(folder-opened)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codexHistory.searchContent",
          "when": "view == codexHistory.sessions",
          "group": "navigation@1"
        },
        {
          "command": "codexHistory.filter",
          "when": "view == codexHistory.sessions",
          "group": "navigation@2"
        },
        {
          "command": "codexHistory.clearFilter",
          "when": "view == codexHistory.sessions && codexHistory.filterActive",
          "group": "navigation@3"
        },
        {
          "command": "codexHistory.toggleWorkspaceScope",
          "when": "view == codexHistory.sessions",
          "group": "navigation@4"
        },
        {
          "command": "codexHistory.refresh",
          "when": "view == codexHistory.sessions",
          "group": "navigation@5"
        },
        {
          "command": "codexHistory.revealCodexHome",
          "when": "view == codexHistory.sessions",
          "group": "9_more@1"
        }
      ],
      "view/item/context": [
        {
          "command": "codexHistory.openInCodex",
          "when": "view == codexHistory.sessions && viewItem == codexSession",
          "group": "1_codex@1"
        },
        {
          "command": "codexHistory.restoreSession",
          "when": "view == codexHistory.sessions && viewItem == codexSessionArchived",
          "group": "1_codex@1"
        },
        {
          "command": "codexHistory.export",
          "when": "view == codexHistory.sessions && viewItem =~ /codexSession/",
          "group": "1_export@1"
        },
        {
          "command": "codexHistory.openRaw",
          "when": "view == codexHistory.sessions && viewItem =~ /codexSession/",
          "group": "1_export@2"
        },
        {
          "command": "codexHistory.revealSession",
          "when": "view == codexHistory.sessions && viewItem =~ /codexSession/",
          "group": "9_more@1"
        }
      ],
      "commandPalette": [
        {
          "command": "codexHistory.openSession",
          "when": "false"
        },
        {
          "command": "codexHistory.openRaw",
          "when": "false"
        },
        {
          "command": "codexHistory.export",
          "when": "false"
        },
        {
          "command": "codexHistory.revealSession",
          "when": "false"
        },
        {
          "command": "codexHistory.openInCodex",
          "when": "false"
        },
        {
          "command": "codexHistory.restoreSession",
          "when": "false"
        },
        {
          "command": "codexHistory.clearFilter",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Codex History Lens",
      "properties": {
        "codexHistory.codexHome": {
          "type": "string",
          "default": "",
          "markdownDescription": "Codex 数据目录，默认使用环境变量 `CODEX_HOME`，否则为 `~/.codex`。插件读取其中的 `sessions/**/*.jsonl` 与 `session_index.jsonl`。"
        },
        "codexHistory.codexPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "`codex` 可执行文件路径，用于取消归档与 `codex resume`。留空时依次查找 PATH 和 Codex VS Code 扩展自带的 `bin/**/codex`。"
        },
        "codexHistory.maxSessions": {
          "type": "number",
          "default": 300,
          "minimum": 10,
          "maximum": 5000,
          "description": "侧栏最多显示的会话数量。"
        },
        "codexHistory.showArchived": {
          "type": "boolean",
          "default": false,
          "description": "是否同时显示 archived_sessions 中已归档的会话。"
        },
        "codexHistory.groupByDate": {
          "type": "boolean",
          "default": true,
          "description": "按天分组显示会话（今天、昨天、11月18日…）。"
        },
        "codexHistory.showToolCalls": {
          "type": "boolean",
          "default": true,
          "description": "在聊天面板中显示工具调用（默认折叠，可在面板中切换）。"
        },
        "codexHistory.showReasoning": {
          "type": "boolean",
          "default": true,
          "description": "在聊天面板中显示可用的思考过程（默认折叠）。"
        },
        "codexHistory.expandToolCalls": {
          "type": "boolean",
          "default": false,
          "description": "打开会话时默认展开工具调用的输入与输出。"
        }
      }
    }
  },
  "scripts": {
    "test": "node test/codexCli.test.js && node test/parser.test.js && node test/renderer.test.js && node test/extension.test.js",
    "build:vsix": "node scripts/build-vsix.js"
  }
}
